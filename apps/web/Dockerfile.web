# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

# Setup pnpm package manager and configure global bin directory for caching.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
ENV NPM_CONFIG_PREFIX="$PNPM_HOME"

# *****************************************************************************
# STAGE 0: Install package tooling
# *****************************************************************************
FROM base AS package-tools
WORKDIR /app

ARG TURBO_VERSION=2.9.18
COPY package.json ./package.json
# Normalize PackageMaze-relative tarball paths before npm installs the bootstrap tools.
RUN --mount=type=secret,id=packagemaze_npmrc,target=/run/secrets/packagemaze.npmrc \
    PNPM_VERSION="$(node -p "const pm = require('./package.json').packageManager || ''; const match = pm.match(/^pnpm@([^+]+)(?:[+].*)?$/); if (!match) throw new Error('Expected packageManager to be pnpm@<version>'); match[1]")" && \
    PACKAGE_MAZE_NPM_REGISTRY="$(NPM_CONFIG_REPLACE_REGISTRY_HOST=never NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc npm config get registry)" && \
    package_tarball_url() { \
      raw_tarball="$(NPM_CONFIG_REPLACE_REGISTRY_HOST=never NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc npm view "$1" dist.tarball)" || return 1; \
      node -e "const raw = process.argv[1].trim(); const registry = process.argv[2].trim(); const origin = new URL(registry).origin + '/'; if (/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)) { process.stdout.write(raw); } else { const cleaned = raw.replace(/^\/+/, ''); const base = cleaned.startsWith('packagemaze/') ? origin : registry; process.stdout.write(new URL(cleaned, base).href); }" "$raw_tarball" "$PACKAGE_MAZE_NPM_REGISTRY"; \
    } && \
    case "$(uname -m)" in \
      x86_64) TURBO_NATIVE_PACKAGE="@turbo/linux-64" ;; \
      aarch64 | arm64) TURBO_NATIVE_PACKAGE="@turbo/linux-arm64" ;; \
      *) echo "Unsupported architecture for turbo: $(uname -m)" >&2; exit 1 ;; \
    esac && \
    PNPM_TARBALL="$(package_tarball_url "pnpm@${PNPM_VERSION}")" && \
    TURBO_TARBALL="$(package_tarball_url "turbo@${TURBO_VERSION}")" && \
    TURBO_NATIVE_TARBALL="$(package_tarball_url "${TURBO_NATIVE_PACKAGE}@${TURBO_VERSION}")" && \
    NPM_CONFIG_REPLACE_REGISTRY_HOST=never \
    NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc \
    npm install --global --no-audit --no-fund --omit=optional "$PNPM_TARBALL" "$TURBO_TARBALL" "$TURBO_NATIVE_TARBALL" && \
    pnpm --version && \
    turbo --version

# *****************************************************************************
# STAGE 1: Build the project
# *****************************************************************************
FROM package-tools AS builder
RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

COPY . .

RUN turbo prune --scope=web --docker

# *****************************************************************************
# STAGE 2: Install dependencies & build the project
# *****************************************************************************
# Add lockfile and package.json's of isolated subworkspace
FROM package-tools AS installer

RUN apk add --no-cache libc6-compat
WORKDIR /app

# First install the dependencies (as they change less often)
COPY .gitignore .gitignore
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Copy full directory structure before fetch to ensure all package.json files are available
COPY --from=builder /app/out/full/ .
COPY turbo.json turbo.json

# Fetch dependencies to cache store, then install offline with dev deps
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    --mount=type=secret,id=packagemaze_npmrc,target=/run/secrets/packagemaze.npmrc \
    NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc pnpm fetch --store-dir=/pnpm/store
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    --mount=type=secret,id=packagemaze_npmrc,target=/run/secrets/packagemaze.npmrc \
    CI=true NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc pnpm install --offline --frozen-lockfile --store-dir=/pnpm/store

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

ARG VITE_ADMIN_BASE_URL=""
ENV VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL

ARG VITE_ADMIN_BASE_PATH="/god-mode"
ENV VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH

ARG VITE_LIVE_BASE_URL=""
ENV VITE_LIVE_BASE_URL=$VITE_LIVE_BASE_URL

ARG VITE_LIVE_BASE_PATH="/live"
ENV VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH

ARG VITE_SPACE_BASE_URL=""
ENV VITE_SPACE_BASE_URL=$VITE_SPACE_BASE_URL

ARG VITE_SPACE_BASE_PATH="/spaces"
ENV VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH

ARG VITE_WEB_BASE_URL=""
ENV VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL

ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=1

RUN --mount=type=secret,id=packagemaze_npmrc,target=/run/secrets/packagemaze.npmrc \
    NPM_CONFIG_USERCONFIG=/run/secrets/packagemaze.npmrc pnpm turbo run build --filter=web

# *****************************************************************************
# STAGE 3: Serve with nginx
# *****************************************************************************
FROM nginx:1.29-alpine AS production

RUN apk update && apk upgrade --no-cache && rm -rf /var/cache/apk/*

COPY apps/web/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=installer /app/apps/web/build/client /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
